<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.dynamisengine.games</groupId>
    <artifactId>dynamis-games</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>skinned-mesh-basics</artifactId>
  <name>Skinned Mesh Basics</name>
  <description>Canonical skinned mesh exemplar using the real DynamisLightEngine pipeline.</description>

  <dependencies>
    <!-- DynamisLightEngine (real rendering pipeline) -->
    <dependency>
      <groupId>org.dynamisengine.light</groupId>
      <artifactId>engine-api</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.dynamisengine.light</groupId>
      <artifactId>engine-spi</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.dynamisengine.light</groupId>
      <artifactId>engine-impl-common</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.dynamisengine.light</groupId>
      <artifactId>engine-impl-opengl</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Animis (animation loading + runtime) -->
    <dependency>
      <groupId>org.dynamisengine.animis</groupId>
      <artifactId>animis</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.dynamisengine.animis</groupId>
      <artifactId>animis-loader</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.dynamisengine.animis</groupId>
      <artifactId>animis-runtime</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!-- MeshForge (GLB mesh loading, transitive via animis-loader) -->
    <dependency>
      <groupId>org.dynamisengine</groupId>
      <artifactId>meshforge-loader</artifactId>
      <version>1.1.0</version>
    </dependency>
    <!-- LWJGL natives -->
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>3.3.6</version>
      <classifier>natives-macos-arm64</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>3.3.6</version>
      <classifier>natives-macos-arm64</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>3.3.6</version>
      <classifier>natives-macos-arm64</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-stb</artifactId>
      <version>3.3.6</version>
      <classifier>natives-macos-arm64</classifier>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
